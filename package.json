{
  "name": "exo-industries",
  "version": "0.3.0",
  "description": "Personal incremental factory and space conquest game",
  "main": "desktop.cjs",
  "author": "EXO Industries",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test engine.test.mjs",
    "dist:win": "electron-builder --win portable --x64",
    "prepare:evolve": "node scripts/prepare-evolve.cjs",
    "start:evolve": "npm run prepare:evolve && electron evolve-desktop",
    "test:evolve": "node --test scripts/evolve-assets.test.cjs",
    "smoke:evolve": "node scripts/evolve-smoke.cjs",
    "dist:evolve:win": "npm run prepare:evolve && electron-builder --projectDir evolve-desktop --win portable --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/lato": "5.2.7",
    "@popperjs/core": "2.9.2",
    "buefy": "0.9.22",
    "chart.js": "3.8.2",
    "electron": "34.5.8",
    "electron-builder": "26.0.12",
    "jquery": "3.6.3",
    "playwright-core": "1.62.1",
    "sortablejs": "1.10.2",
    "vue": "2.7.14"
  },
  "build": {
    "appId": "local.exo.industries",
    "productName": "EXO Industries",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "engine.mjs",
      "desktop.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "EXO-Industries-${version}-Windows.exe"
    },
    "compression": "store"
  }
}
